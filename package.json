{
  "name": "tokenlighten-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.13.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takayuki-Ishimaru/tokenlighten.git"
  },
  "homepage": "https://github.com/Takayuki-Ishimaru/tokenlighten",
  "bugs": {
    "url": "https://github.com/Takayuki-Ishimaru/tokenlighten/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tokenlighten/types && npm run build --workspace @tokenlighten/usage && npm run build --workspace @tokenlighten/skeleton-engine && npm run build --workspace @tokenlighten/agents-md && npm run build --workspace @tokenlighten/cli && npm run build --workspace @tokenlighten/mcp-server && npm run build --workspace tokenlighten-vscode-extension",
    "test": "npm run test:packages && npm run test:bundle-cli",
    "test:packages": "npm run lint && vitest run --minWorkers=1 --maxWorkers=2 --testTimeout=120000",
    "test:bundle-cli": "npm run test:bundle-cli --workspace tokenlighten-vscode-extension",
    "lint": "npm run build && npm run typecheck:test --workspaces --if-present",
    "licenses": "node scripts/licenses-check.mjs",
    "licenses:notices": "node scripts/licenses-check.mjs --notice-out THIRD_PARTY_NOTICES.md && node scripts/sync-vscode-notices.mjs",
    "generate": "node packages/agents-md/dist/cli.js update --force",
    "doctor": "node packages/cli/dist/index.js doctor",
    "package:vsix": "npm run package --workspace tokenlighten-vscode-extension"
  },
  "overrides": {
    "unzipper": "0.10.11",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "cross-spawn": "^7.0.6",
    "license-checker-rseidelsohn": "^4",
    "tsx": "^4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
