{
  "name": "@tokenlighten/agents-md",
  "version": "0.12.1",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "import": "./dist/version.js",
      "types": "./dist/version.d.ts"
    },
    "./sentinel": {
      "import": "./dist/sentinel.js",
      "types": "./dist/sentinel.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "tl-agents": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tokenlighten/types": "*"
  },
  "devDependencies": {
    "vitest": "*"
  },
  "files": [
    "dist",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takayuki-Ishimaru/tokenlighten.git"
  },
  "homepage": "https://github.com/Takayuki-Ishimaru/tokenlighten",
  "bugs": {
    "url": "https://github.com/Takayuki-Ishimaru/tokenlighten/issues"
  }
}
