{
  "name": "tokenlighten-vscode-extension",
  "displayName": "TokenLighten",
  "version": "0.16.3",
  "private": true,
  "description": "%extension.description%",
  "publisher": "tokenlighten",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#191827",
    "theme": "dark"
  },
  "engines": {
    "vscode": ">=1.105.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "tokenlighten.licenses.show",
        "title": "%command.licenses.show%"
      },
      {
        "command": "tokenlighten.engines.show",
        "title": "%command.engines.show%"
      },
      {
        "command": "tokenlighten.status",
        "title": "%command.status%"
      },
      {
        "command": "tokenlighten.setup",
        "title": "%command.setup%"
      },
      {
        "command": "tokenlighten.usage.show",
        "title": "%command.usage.show%"
      },
      {
        "command": "tokenlighten.logs.export",
        "title": "%command.logs.export%"
      },
      {
        "command": "tokenlighten.uninstallMachine",
        "title": "%command.uninstallMachine%"
      },
      {
        "command": "tokenlighten.copilotGuide.applyToWorkspaceFile",
        "title": "%command.copilotGuide.applyToWorkspaceFile%"
      },
      {
        "command": "tokenlighten.session.native",
        "title": "TokenLighten: Use Native Tools for This Session"
      },
      {
        "command": "tokenlighten.session.tl",
        "title": "TokenLighten: Resume Automatic Activation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlighten-sidebar",
          "title": "TokenLighten",
          "icon": "media/tokenlighten.png"
        }
      ]
    },
    "views": {
      "tokenlighten-sidebar": [
        {
          "type": "webview",
          "id": "tokenlighten-control-center",
          "name": "%view.controlCenter%"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "tokenlighten.mcp",
        "label": "TokenLighten"
      }
    ],
    "configuration": {
      "title": "TokenLighten",
      "properties": {
        "tokenlighten.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.enabled%"
        },
        "tokenlighten.autoUpdate.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.autoUpdate.enabled%"
        },
        "tokenlighten.updateCheck.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.updateCheck.enabled%"
        },
        "tokenlighten.confirmResetOnUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.confirmResetOnUpdate%"
        },
        "tokenlighten.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ja%"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%config.language%"
        },
        "tokenlighten.guideProfile": {
          "type": "string",
          "enum": [
            "full",
            "medium",
            "compact",
            "portable"
          ],
          "default": "compact",
          "scope": "resource",
          "description": "Guide profile injected during workspace setup."
        },
        "tokenlighten.copilotGuide": {
          "type": "string",
          "enum": [
            "standalone",
            "agents-md"
          ],
          "enumDescriptions": [
            "GitHub Copilot reads a compact TokenLighten guide from .github/copilot-instructions.md; setup stops Copilot attaching AGENTS.md while it holds only TokenLighten's block. Codex and Claude Code read the selected AGENTS.md profile (compact by default). In a window opened through a .code-workspace file, the setting goes into the workspace file after you confirm.",
            "GitHub Copilot attaches AGENTS.md and reads the TokenLighten guide there."
          ],
          "default": "standalone",
          "scope": "resource",
          "description": "Which TokenLighten guide GitHub Copilot reads, applied by workspace setup."
        },
        "tokenlighten.toolSurface": {
          "type": "string",
          "enum": [
            "full",
            "code"
          ],
          "enumDescriptions": [
            "Every capability, including Office/archive/encrypted-artifact inputs.",
            "Code/plain-text/config read, edit, and search only — a smaller tool schema."
          ],
          "default": "full",
          "scope": "resource",
          "description": "Advertised MCP tool surface. Changing this requires reconnecting (a new schema stamp is generated)."
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && node scripts/generate-schema-stamp.mjs && node esbuild.config.mjs && tsc --noEmit",
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "vscode:prepublish": "npm --prefix ../.. run build && npm run bundle-cli",
    "package": "vsce package --no-dependencies",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test:bundle-cli": "node scripts/test-bundle-cli-setup.mjs && node scripts/test-bundle-engines.mjs",
    "test": "vitest run && npm run test:bundle-cli"
  },
  "dependencies": {
    "@tokenlighten/agents-md": "*",
    "@tokenlighten/cli": "*",
    "@tokenlighten/usage": "*",
    "cross-spawn": "^7.0.6",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@tokenlighten/mcp-server": "*",
    "@types/node": "^20",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takayuki-Ishimaru/tokenlighten.git"
  },
  "homepage": "https://github.com/Takayuki-Ishimaru/tokenlighten",
  "bugs": {
    "url": "https://github.com/Takayuki-Ishimaru/tokenlighten/issues"
  }
}
