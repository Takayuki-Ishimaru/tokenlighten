{
  "name": "@tokenlighten/skeleton-engine",
  "version": "0.9.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Skeleton + symbol-locator engine for TokenLighten — PageRank repo map, symbol range resolution, apiGraph",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "tl-skeleton": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "npm run typecheck:test && vitest run"
  },
  "dependencies": {
    "@tokenlighten/types": "*",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.6.3",
    "vitest": "^2.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takayuki-Ishimaru/tokenlighten.git"
  },
  "homepage": "https://github.com/Takayuki-Ishimaru/tokenlighten",
  "bugs": {
    "url": "https://github.com/Takayuki-Ishimaru/tokenlighten/issues"
  }
}
