{
  "name": "@tokenlighten/cli",
  "version": "0.12.1",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./launcher": {
      "import": "./dist/launcher.js",
      "types": "./dist/launcher.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "tl": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tokenlighten/types": "*",
    "@tokenlighten/agents-md": "*",
    "@tokenlighten/mcp-server": "*",
    "@tokenlighten/skeleton-engine": "*",
    "@tokenlighten/usage": "*",
    "cross-spawn": "^7.0.6",
    "exceljs": "^4.4.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takayuki-Ishimaru/tokenlighten.git"
  },
  "homepage": "https://github.com/Takayuki-Ishimaru/tokenlighten",
  "bugs": {
    "url": "https://github.com/Takayuki-Ishimaru/tokenlighten/issues"
  }
}
